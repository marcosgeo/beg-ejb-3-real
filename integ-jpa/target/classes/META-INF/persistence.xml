<?xml version="1.0" encoding="UTF-8"?>
<persistence
	version="2.0"
	xmlns="https://xml.jcp.org/xml/ns/persistence"
	xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://xml.jcp.org/xml/ns/persistence https://xml.jcp.org/xml/ns/persistence/persistence_2_0.xsd">
	
	<persistence-unit name="Chapter07-WineAppUnit-ResourceLocal" transaction-type="RESOURCE_LOCAL">
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
		<class>geo.marcos.chp7.entities.Individual</class>
		<class>geo.marcos.chp7.entities.CustomerOrder</class>
		<class>geo.marcos.chp7.entities.Customer</class>
		<class>geo.marcos.chp7.entities.OrderItem</class>
		<class>geo.marcos.chp7.entities.InventoryItem</class>
		<class>geo.marcos.chp7.entities.BusinessContatict</class>
		<class>geo.marcos.chp7.entities.Distributor</class>
		<class>geo.marcos.chp7.entities.CartItem</class>
		<class>geo.marcos.chp7.entities.Address</class>
		<class>geo.marcos.chp7.entities.Wine</class>
		<class>geo.marcos.chp7.entities.Supplier</class>
		<class>geo.marcos.chp7.entities.WineItem</class>
		<properties>
			<property name="javax.persistence.jdbc.url" 
						value="jdbc:mysql://localhost:3306/wineapp"/>
			<property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
			<property name="javax.persistence.jdbc.user" value="marcos"/>
			<property name="javax.persistence.jdbc.password" value=".senha."/>
			<property name="eclipselink.ddl-generation" value="create-tables"/>
		</properties>
	</persistence-unit>

	<persistence-unit name="Chapter07-WineAppUnit-JTA" transaction-type="RESOURCE_LOCAL">
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
		<class>geo.marcos.chp7.entities.Individual</class>
		<class>geo.marcos.chp7.entities.CustomerOrder</class>
		<class>geo.marcos.chp7.entities.Customer</class>
		<class>geo.marcos.chp7.entities.OrderItem</class>
		<class>geo.marcos.chp7.entities.InventoryItem</class>
		<class>geo.marcos.chp7.entities.BusinessContatict</class>
		<class>geo.marcos.chp7.entities.Distributor</class>
		<class>geo.marcos.chp7.entities.CartItem</class>
		<class>geo.marcos.chp7.entities.Address</class>
		<class>geo.marcos.chp7.entities.Wine</class>
		<class>geo.marcos.chp7.entities.Supplier</class>
		<class>geo.marcos.chp7.entities.WineItem</class>
		<properties>
			<property name="javax.persistence.jdbc.url" 
						value="jdbc:mysql://localhost:3306/wineapp"/>
			<property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
			<property name="javax.persistence.jdbc.user" value="marcos"/>
			<property name="javax.persistence.jdbc.password" value=".senha."/>
			<property name="eclipselink.ddl-generation" value="create-tables"/>
		</properties>
	</persistence-unit>
</persistence>